{
  "schemaVersion": "1.2.0",
  "gatewayVersion": "0.7.0",
  "build": "Formal Build 335",
  "mode": "development",
  "humanApprovalRequired": true,
  "routes": [
    "/ai/health",
    "/ai/context",
    "/ai/files",
    "/ai/search?q=<term>&limit=<1-100>",
    "/ai/file?path=<allowed-path>",
    "/ai/manifest",
    "/bridge/snapshot (Studio explicit sync only)"
  ],
  "allowedFiles": [
    "README.md",
    "VERSION.txt",
    "BUILD335_PHASE_AND_PLAN_STATUS.md",
    "AUDIT_REPORT_BUILD_335.md",
    "DECISION_LOG.md",
    "CPF_BASIC_SPECIFICATION.md",
    "CPF_DATA_SPECIFICATION.md",
    "CPF_API_READINESS_SPECIFICATION.md",
    "CPF_CLI_SPECIFICATION.md",
    "CPF_NODE_MODEL_SPECIFICATION.md",
    "CPF_STORY_PREVIEW_REBUILD_SPECIFICATION.md",
    "CPF_IMPLEMENTATION_PLAN.md",
    "CPF_EXECUTION_PLAN.md",
    "CPF_TEST_PLAN.md",
    "CPF_ACCEPTANCE_CRITERIA.md",
    "project-data.json",
    "studio-update.json",
    "package_manifest.json",
    "cpf/src/Core/CpfProjectManager.php",
    "cpf/src/Core/JsonStore.php",
    "cpf/src/Core/CpfNodeManager.php",
    "cpf/src/Core/CpfRegenerationManager.php",
    "cpf/src/Dependency/CpfDependencyManager.php",
    "cpf/src/Validation/CpfValidator.php",
    "cpf/src/Diff/CpfDiffService.php",
    "cpf/src/Workflow/CpfWorkflowManager.php",
    "ai-gateway-server/README.md",
    "ai-gateway-server/router.php",
    "ai-gateway-server/config.example.php"
  ],
  "capabilities": [
    "context-profiles",
    "source-index",
    "allowlisted-file-read",
    "allowlisted-full-text-search",
    "handover-bundle",
    "human-approval-gate",
    "local-http-bridge",
    "bearer-token-auth",
    "origin-allowlist",
    "explicit-context-snapshot-sync"
  ],
  "handoverFiles": [
    "BUILD335_PHASE_AND_PLAN_STATUS.md",
    "DECISION_LOG.md",
    "README.md",
    "CPF_IMPLEMENTATION_PLAN.md",
    "CPF_ACCEPTANCE_CRITERIA.md"
  ]
}
