      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "RULE-DEV-SAVE-002",
      "text": "Project revisionによる保存・競合管理は行わず、Git SHAだけでRemote競合を検出する。",
      "status": "Active",
      "source_type": "HumanInstruction",
      "source_id": "conversation",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "RULE-DEV-SAVE-003",
      "text": "部分JSONは単体で完全Project検証せず、現在案件のcloneへ反映した後の完成Project全体を検証する。",
      "status": "Active",
      "source_type": "AuditFinding",
      "source_id": "GKS-B743-save-path-audit",
      "created_at": "2026-08-23T07:24:00+09:00",
