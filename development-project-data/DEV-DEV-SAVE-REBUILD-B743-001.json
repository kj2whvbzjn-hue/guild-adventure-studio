  "implementation_records": [],
  "discussions": [],
  "decisions": [
    {
      "id": "DEC-DEV-SAVE-001",
      "title": "GitをDevelopment Project本文の唯一の正本とする",
      "status": "Proposed",
      "text": "案件一覧は軽量indexだけを読み、案件選択確認後に対象Project JSONをGitから取得する。Project本文はブラウザRegistryから復元しない。",
      "rationale": "本文の複製正本をなくし、選択・保存・再読込の参照元をGitへ一本化するため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-002",
      "title": "競合検知はGit SHAだけを使用する",
      "status": "Proposed",
      "text": "Project revisionの比較・加算・保存判定を廃止し、案件を開いた時のGit SHAと保存直前のRemote SHAが一致する場合だけPUTする。",
      "rationale": "Gitが正本ならSHAでRemote世代を一意に確認でき、独自revision同期を持つ必要がないため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-003",
      "title": "JSON統合は結合後Project全体を検証する",
      "status": "Proposed",
      "text": "incoming部分データを単体完全Projectとして検証しない。current Project cloneへ差分適用後、参照関係を含む完成Project全体を1回検証し、成功時のみcurrentへ反映する。",
      "rationale": "既存案件内に存在するdepends_on等を部分JSON単体検証が見失い、正常データを誤拒否するため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    }
  ],
  "specifications": [
    {
      "id": "SPEC-DEV-SAVE-001",
      "title": "案件一覧・案件読込のGit正本仕様",
      "status": "Draft",
      "summary": "初期表示は軽量indexのタイトル一覧だけとし、選択確認後に対象案件本文をGit GETする。",
      "body": "1. 初期表示で development-project-data/index.json を取得する。\n2. 一覧には案件タイトルだけを表示する。\n3. タイトル選択時に確認を表示する。\n4. 承認後に development-project-data/<id>.json をGitから取得する。\n5. 取得したJSONとSHAを現在案件として保持する。\n6. Project本文取得失敗時にlocalStorage本文へfallbackしない。",
      "decision_refs": [
        "DEC-DEV-SAVE-001",
        "DEC-DEV-SAVE-002"
      ],
      "depends_on": [],
      "acceptance_criteria": "案件一覧表示時に全Project本文を読まず、案件承認後だけ選択案件本文がGitから取得される。localStorage本文fallbackが存在しない。",
      "system_node_id": "SYS-DEV-PROJECT-LIST",
      "contract_ids": [
        "CONTRACT-DEV-LIST-GIT"
      ],
      "source_candidate_id": "",
      "material_snapshot_hash": "",
      "revision": 0,
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "SPEC-DEV-SAVE-002",
      "title": "Current Project安全編集仕様",
      "status": "Draft",
      "summary": "編集はcurrent Projectのcloneへ適用し、検証成功時のみcurrentを置換する。",
      "body": "1. 表示用current Projectから編集用cloneを作る。\n2. CRUD変更はcloneへ適用する。\n3. normalize/reference validationをclone全体へ実行する。\n4. 検証失敗時はcurrent Projectを一切変更しない。\n5. 検証成功時だけcurrent Projectを置換してdirty化する。",
      "decision_refs": [],
      "depends_on": [],
      "acceptance_criteria": "無効な編集を発生させてもcurrent Projectが変更されず、再描画後も変更前データが維持される。",
      "system_node_id": "SYS-DEV-PROJECT-EDITOR",
      "contract_ids": [
        "CONTRACT-DEV-EDITOR-VALIDATOR"
      ],
      "source_candidate_id": "",
      "material_snapshot_hash": "",
      "revision": 0,
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "SPEC-DEV-SAVE-003",
      "title": "部分JSON統合仕様",
      "status": "Draft",
      "summary": "current cloneへincoming差分を反映してから完成Project全体を検証する。",
      "body": "1. current Projectをcloneする。\n2. incomingの対象collectionだけをmerge/upsertする。\n3. current側にだけ存在する関連Recordを保持する。\n4. merged Project全体をnormalize/reference validationする。\n5. 成功時だけcurrent Projectをmergedへ置換する。\n6. 失敗時はエラーを表示し、current Projectは変更しない。",
      "decision_refs": [
        "DEC-DEV-SAVE-003"
      ],
      "depends_on": [],
      "acceptance_criteria": "incoming taskのdepends_onがcurrent案件内の既存Taskを指す場合は正常統合され、merged後にも存在しない依存だけが拒否される。",
      "system_node_id": "SYS-DEV-JSON-MERGE",
      "contract_ids": [
        "CONTRACT-DEV-MERGE-EDITOR"
      ],
      "source_candidate_id": "",
      "material_snapshot_hash": "",
      "revision": 0,
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "SPEC-DEV-SAVE-004",
      "title": "Git保存・競合・再取得仕様",
      "status": "Draft",
      "summary": "保存はGit SHAを競合判定に使い、PUT後に再GETして内容一致まで確認する。",
      "body": "1. open時に取得したRemote SHAを保持する。\n2. 保存直前にRemoteを再GETしてSHAを確認する。\n3. SHA不一致なら保存を停止して競合を通知する。\n4. SHA一致ならcurrent Project JSONをPUTする。\n5. PUT後にRemoteを再GETする。\n6. normalize後のRemote内容と保存対象current Projectが一致した場合だけ保存完了とする。",
      "decision_refs": [
        "DEC-DEV-SAVE-002"
      ],
      "depends_on": [],
      "acceptance_criteria": "Remote変更時は上書きせず停止し、正常保存時は再GETしたProjectが保存対象と一致する。",
      "system_node_id": "SYS-DEV-GIT-STORE",
      "contract_ids": [
        "CONTRACT-DEV-EDITOR-GIT",
        "CONTRACT-DEV-GIT-REMOTE"
      ],
      "source_candidate_id": "",
      "material_snapshot_hash": "",
      "revision": 0,
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "SPEC-DEV-SAVE-005",
      "title": "Git接続先決定仕様",
      "status": "Draft",
      "summary": "Development保存先はStudio共通Git設定を基準に一意に決定し、過去Registry値や固定defaultで上書きしない。",
      "body": "owner/repo/branchはStudio共通Git設定を基準に解決する。案件Registryに残る過去のgit_remote値や固定default branchをStudio設定より優先しない。canonical pathは development-project-data/<workspace.id>.json に固定する。",
      "decision_refs": [
        "DEC-DEV-SAVE-001"
      ],
      "depends_on": [],
      "acceptance_criteria": "画面のStudio Git設定と実際のDevelopment GET/PUT先owner/repo/branchが一致する。",
      "system_node_id": "SYS-DEV-GIT-STORE",
      "contract_ids": [
        "CONTRACT-DEV-GIT-REMOTE"
      ],
      "source_candidate_id": "",
      "material_snapshot_hash": "",
