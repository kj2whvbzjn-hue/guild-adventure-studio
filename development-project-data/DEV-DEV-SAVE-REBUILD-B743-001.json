  "implementation_records": [],
  "discussions": [],
  "decisions": [
    {
      "id": "DEC-DEV-SAVE-001",
      "title": "GitをDevelopment Project本文の唯一の正本とする",
      "status": "Proposed",
      "text": "案件一覧は軽量indexだけを読み、案件選択確認後に対象Project JSONをGitから取得する。Project本文はブラウザRegistryから復元しない。",
      "rationale": "本文の複製正本をなくし、選択・保存・再読込の参照元をGitへ一本化するため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-002",
      "title": "競合検知はGit SHAだけを使用する",
      "status": "Proposed",
      "text": "Project revisionの比較・加算・保存判定を廃止し、案件を開いた時のGit SHAと保存直前のRemote SHAが一致する場合だけPUTする。",
      "rationale": "Gitが正本ならSHAでRemote世代を一意に確認でき、独自revision同期を持つ必要がないため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-003",
      "title": "JSON統合は結合後Project全体を検証する",
      "status": "Proposed",
      "text": "incoming部分データを単体完全Projectとして検証しない。current Project cloneへ差分適用後、参照関係を含む完成Project全体を1回検証し、成功時のみcurrentへ反映する。",
      "rationale": "既存案件内に存在するdepends_on等を部分JSON単体検証が見失い、正常データを誤拒否するため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T07:24:00+09:00",
      "updated_at": "2026-08-23T07:24:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-004",
      "title": "Git書込操作はBranch+PATを毎回直接入力する",
      "status": "Proposed",
      "text": "新規保存、JSON新規保存、統合保存、編集保存、削除の操作UIにBranchとPATを常時表示する。PATの有無、認証要否、Branch設定済み等の事前条件判定は行わず、入力されたBranch/PATでGit処理を直接実行する。",
      "rationale": "必要条件を事前判定して別画面へ遷移する経路そのものが無駄であり、操作完了までを一画面に閉じるため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T08:52:00+09:00",
      "updated_at": "2026-08-23T08:52:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-005",
      "title": "Git Branchを操作単位で一本化する",
      "status": "Proposed",
      "text": "操作画面で入力されたBranchをProject処理とindex処理の両方へそのまま渡す。処理後のDevelopmentセッションも同Branchを現在Branchとして扱い、一覧refreshで別Branchへ戻さない。",
      "rationale": "Projectを指定Branchへ保存した直後に別Branchのindexを読み、案件が消えたように見える不整合を防ぐため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T08:52:00+09:00",
      "updated_at": "2026-08-23T08:52:00+09:00"
    },
    {
      "id": "DEC-DEV-SAVE-006",
      "title": "旧Development Git経路を残さない",
      "status": "Proposed",
      "text": "localStorage案件一覧fallback、Registry由来Git接続fallback、固定default接続先、旧Git管理画面へ遷移するAPI/CSS、死んだProject Settings処理、Development CRUD二重定義を撤去する。",
      "rationale": "新経路と旧経路の併存による後勝ち上書き・別接続先利用・古い一覧復活を防止するため。",
      "source_discussion_ids": [],
      "approved_by": "",
      "approved_at": "",
      "created_at": "2026-08-23T08:52:00+09:00",
      "updated_at": "2026-08-23T08:52:00+09:00"
    }
  ],
  "specifications": [
    {
      "id": "SPEC-DEV-SAVE-001",
      "title": "案件一覧・案件読込のGit正本仕様",
      "status": "Draft",
      "summary": "初期表示は軽量indexのタイトル一覧だけとし、選択確認後に対象案件本文をGit GETする。",
      "body": "1. 初期表示で development-project-data/index.json を取得する。\n2. 一覧には案件タイトルだけを表示する。\n3. タイトル選択時に確認を表示する。\n4. 承認後に development-project-data/<id>.json をGitから取得する。\n5. 取得したJSONとSHAを現在案件として保持する。\n6. Project本文取得失敗時にlocalStorage本文へfallbackしない。",
      "decision_refs": [
        "DEC-DEV-SAVE-001",
        "DEC-DEV-SAVE-002"
      ],
      "depends_on": [],
      "acceptance_criteria": "案件一覧表示時に全Project本文を読まず、案件承認後だけ選択案件本文がGitから取得される。localStorage本文fallbackが存在しない。",
