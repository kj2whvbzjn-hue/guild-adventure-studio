    },
    {
      "id": "RULE-DEV-SAVE-004",
      "text": "検証前にcurrent Project本文を直接変更しない。編集・統合はcloneへ適用し、全体検証成功後にだけcurrent Projectを置換する。",
      "status": "Active",
      "source_type": "AuditFinding",
      "source_id": "GKS-B743-save-path-audit",
