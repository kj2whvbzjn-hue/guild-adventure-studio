    },
    {
      "id": "SPEC-DEV-SAVE-006",
      "title": "案件index整合仕様",
      "status": "Draft",
      "summary": "軽量案件indexはGit上だけで管理し、localStorage一覧を混ぜない。",
      "body": "index.jsonはid/titleを中心とした軽量一覧とする。Git index取得失敗時にlocalStorage Registryから古い案件を復元しない。新規作成・名称変更・削除ではProject本文操作とindex更新の結果を個別確認し、部分失敗を成功扱いしない。",
      "decision_refs": [
        "DEC-DEV-SAVE-001"
      ],
      "depends_on": [],
      "acceptance_criteria": "削除済み案件がlocalStorage情報から一覧へ復活せず、Project本文とindexの片方だけ失敗した場合は明示的に失敗状態が通知される。",
      "system_node_id": "SYS-DEV-PROJECT-LIST",
      "contract_ids": [
        "CONTRACT-DEV-LIST-GIT"
      ],
