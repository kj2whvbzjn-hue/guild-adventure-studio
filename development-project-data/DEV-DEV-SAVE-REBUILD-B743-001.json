  "project_context": {
    "purpose": "Development管理の案件選択・Git読込・編集・JSON統合・検証・保存・Git再取得までの保存経路を一本化し、部分修正の積み重ねで再発している保存不具合を根本解消する。",
    "summary": "GKS-B743の保存経路再監査で確認した、部分JSONの単体事前検証、検証前のcurrent workspace直接変更、同名CRUD関数の重複定義、Git接続先決定の優先順位不整合、localStorage Registry fallback、Git indexとProject本文の不整合、保存Round-trip専用テスト不足をまとめて是正する。Project本文の正本はGitとし、案件一覧は軽量index、案件本文は選択確認後にGitから取得する。Project revision管理は使用せずGit SHAで競合を検出する。"
  },
  "current_focus": {
    "architecture_id": "ARCH-DEV-SAVE-ROOT",
    "work_box_id": "BOX-DEV-SAVE-CORE",
    "theme": "Development管理の保存経路全体再構築",
    "goal": "open → edit/merge → validate → save → Git re-fetch → reopen の一貫した単一経路を確立する。"
  },
  "project_rules": [
    {
      "id": "RULE-DEV-SAVE-001",
      "text": "Development Project本文の正本はGit上の development-project-data/<workspace.id>.json とし、localStorage Registryを本文authorityやfallback正本として使用しない。",
      "status": "Active",
