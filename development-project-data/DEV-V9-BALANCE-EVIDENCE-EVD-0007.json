  "authority_basis": {
    "parent_allocation_decision": "DEC-BAL-PHYSICAL-SKILLLEVEL-ALLOCATION-001",
    "total_skill_budget_authority": "B_spent = SLv",
    "allocation_formula_context": "SLv = M_Range * (sum(C_Damage(Power_i)) + C_MultiHit(H)) - R_MP(MP) - R_CD(CD) - R_Cast(Cast)",
    "inverse_allocation_context": "EffectBudget = (SLv + R_MP + R_CD + R_Cast) / M_Range - C_MultiHit",
    "damage_component_variable": "B_Damage = the portion of EffectBudget allocated to one Physical DAMAGE hit",
    "calibration_identity_only": "For these tests only: 1Hit, SINGLE, MP0, CD0, Cast0, Range-neutral => B_Damage = B_spent = SLv.",
    "candidate_mapping_tested": "Power = round(100 + k * B_Damage)",
    "selected_k": 2,
    "selected_mapping": "f_Damage(B_Damage) = round(100 + 2 * B_Damage)",
    "tested_integer_budget_points": {
      "1": 102,
      "10": 120,
      "20": 140
    },
    "semantic_boundary": {
      "approved": "k=2 is Damage Budget -> Power conversion.",
      "rejected_interpretation": "Do not use k=2 as a universal direct SLv -> final Skill Power formula.",
      "why": "SLv is the total Skill Budget and must first be distributed across Damage/Multi-hit/MP/Cooldown/Cast/Range."
    },
    "inverse_cost_boundary": {
      "C_Damage_for_arbitrary_rounded_power": "Not independently frozen by EVD-0007.",
      "budget_accounting_rule": "For generated Skills, preserve allocated B_Damage as the Budget authority and derive Power from f_Damage.",
      "fractional_budget_rounding": "Not expanded by this Evidence beyond the already-approved/tested round notation; tested points are integer and rounding-ambiguous cases were not required."
    },
    "pending_functions_not_fixed_here": [
      "C_MultiHit(H)",
      "R_MP(MP)",
      "R_CD(CD)",
      "R_Cast(Cast)",
      "M_Range",
      "same-SLv cross-build equivalence tolerance"
    ],
    "selection_basis": [
      "k=1 and k=2 were monotonic for Budget 1->10->20 across all 12 Level rows.",
      "On 11 valid Control rows, k=2 produced stronger reproducible differentiation than k=1.",
      "At Damage Budget 20, k=2 reached >=95% win rate on 4/11 valid Control rows, not a majority.",
      "The Human-approved robustness selection rule therefore advances k=2."
    ],
    "human_review": "All 12 Level rows / 84 win-rate outcomes, aggregate deltas, saturation counts, and k=2 selection were presented before Evidence creation. Human then clarified the intended Skill Budget allocation meaning and explicitly requested the corrected management JSON plus sequential Evidence."
  },
