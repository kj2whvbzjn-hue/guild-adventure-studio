{
  "schema_version": 1,
  "hosting": "github-pages-static",
  "base_path_policy": "repository-relative",
  "public_entrypoints": [
    {
      "id": "game",
      "path": "index.html"
    },
    {
      "id": "studio",
      "path": "studio/index.html"
    }
  ],
  "pwa": {
    "manifest": "manifest.webmanifest",
    "service_worker": "sw.js",
    "icons": [
      "icon-192.png",
      "icon-512.png"
    ]
  },
  "forbidden_runtime_requirements": [
    "php",
    "node-server",
    "database"
  ]
}
