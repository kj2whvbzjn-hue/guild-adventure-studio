{
  "schema_version": 1,
  "policy": "Game and Studio are physically separated. Each app owns its entrypoint and local runtime assets; root is a launcher only.",
  "components": [
    {
      "id": "launcher",
      "entrypoint": "index.html",
      "owned_paths": [
        "index.html",
        "manifest.webmanifest",
        "sw.js",
        "icon-192.png",
        "icon-512.png"
      ],
      "required_shared_assets": []
    },
    {
      "id": "game-runtime",
      "entrypoint": "game/index.html",
      "owned_paths": [
        "game/index.html",
        "game/manifest.webmanifest",
        "game/sw.js",
        "game/icon-192.png",
        "game/icon-512.png"
      ],
      "required_shared_assets": []
    },
    {
      "id": "studio-runtime",
      "entrypoint": "studio/index.html",
      "owned_paths": [
        "studio/index.html",
        "studio/export-core.js",
        "studio/jszip.min.js",
        "studio/manifest.webmanifest",
        "studio/sw.js",
        "studio/icon-192.png",
        "studio/icon-512.png",
        "studio/ai-production/ai-production.css",
        "studio/ai-production/ai-production-ui.js",
        "studio/ai-production/ai-master-adapter.js",
        "studio/ai-production/ai-program-model.js",
        "studio/ai-production/ai-program-store.js",
        "studio/ai-production/ai-program-editor.js",
        "studio/ai-production/ai-program-validator.js",
        "studio/ai-production/ai-program-compiler.js",
        "studio/ai-production/ai-program-trace.js",
        "studio/ai-production/ai-decision-engine.js",
        "studio/ai-production/ai-battle-adapter.js",
        "studio/ai-production/ai-simulation-runner.js",
        "studio/ai-production/manifest.json"
      ],
      "required_shared_assets": []
    },
    {
      "id": "project-data",
      "entrypoint": "project-data.json",
      "owned_paths": [
        "project-data.json"
      ],
      "required_shared_assets": []
    }
  ]
}
