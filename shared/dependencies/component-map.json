{
  "schema_version": 1,
  "policy": "Game and Studio are physically separated. Each app owns its entrypoint and local runtime assets; root is a launcher only.",
  "components": [
    {
      "id": "launcher",
      "entrypoint": "index.html",
      "owned_paths": [
        "index.html",
        "manifest.webmanifest",
        "sw.js",
        "icon-192.png",
        "icon-512.png"
      ],
      "required_shared_assets": []
    },
    {
      "id": "game-runtime",
      "entrypoint": "game/index.html",
      "owned_paths": [
        "game/index.html",
        "game/manifest.webmanifest",
        "game/sw.js",
        "game/icon-192.png",
        "game/icon-512.png"
      ],
      "required_shared_assets": []
    },
    {
      "id": "studio-runtime",
      "entrypoint": "studio/index.html",
      "owned_paths": [
        "studio/index.html",
        "studio/adventure-entity-json-import.js",
        "studio/export-core.js",
        "studio/data-exchange/full-import-gate.js",
        "studio/data-exchange/data-exchange-integrity-validator.js",
        "studio/data-exchange/data-exchange-core.js",
        "studio/data-exchange/data-exchange-transaction.js",
        "studio/data-exchange/data-exchange-audit.js",
        "studio/data-exchange/data-exchange-ui.js",
        "studio/jszip.min.js",
        "studio/manifest.webmanifest",
        "studio/sw.js",
        "studio/icon-192.png",
        "studio/icon-512.png"
      ],
      "required_shared_assets": []
    },
    {
      "id": "project-data",
      "entrypoint": "project-data.json",
      "owned_paths": [
        "project-data.json"
      ],
      "required_shared_assets": []
    }
  ]
}
