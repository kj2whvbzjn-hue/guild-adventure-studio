{
  "schema_version": 1,
  "phase": "R03-F4",
  "purpose": "Freeze the responsibility boundary between APPLY lifecycle management and future Trigger/Effect execution layers.",
  "apply_lifecycle_engine": {
    "owns": [
      "resolve",
      "apply",
      "expire",
      "cleanup",
      "consume",
      "effective"
    ],
    "kinds": [
      "STATUS",
      "DOT",
      "BUFF",
      "DEBUFF",
      "SHIELD"
    ],
    "does_not_own": [
      "TRIGGER_DISPATCH",
      "TARGET_RESOLUTION",
      "DAMAGE_FORMULA",
      "HEAL_FORMULA",
      "RESOURCE_COST",
      "COVER_ROUTING",
      "COUNTER_CHAIN",
      "FOLLOW_UP_CHAIN",
      "AURA_TRIGGER"
    ]
  },
  "effect_handlers_own": [
    "DOT_DAMAGE_FORMULA",
    "STATUS_RESISTANCE",
    "BUFF_STAT_APPLICATION",
    "DEBUFF_STAT_APPLICATION",
    "SHIELD_DAMAGE_ABSORPTION"
  ],
  "trigger_layer_future_owns": [
    "TRIGGER_DISPATCH",
    "TRIGGER_RECURSION_GUARD",
    "TRIGGER_PRIORITY",
    "TRIGGER_SOURCE_EVENT_MATCHING"
  ],
  "rule": "R04 Trigger implementation must consume Effect execution APIs without adding trigger semantics to GKSApplyLifecycleEngine."
}
