{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared/integrity/inspection-evidence.schema.json",
  "title": "Guild Adventure Studio Inspection Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "context",
    "status",
    "source_tree_before_sha256",
    "source_tree_after_sha256",
    "source_tree_unchanged",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "profile": {
      "enum": [
        "quick",
        "full",
        "release"
      ]
    },
    "context": {
      "enum": [
        "source",
        "update"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "input_zip_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_before_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_unchanged": {
      "type": "boolean"
    },
    "evidence_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array"
    }
  }
}
