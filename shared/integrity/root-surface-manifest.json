{
  "schema_version": 1,
  "purpose": "Protect current repository-root runtime files and reject references to removed historical layouts.",
  "policy": {
    "runtime_paths_are_protected": true,
    "historical_root_documents_are_retained": false,
    "runtime_files_moved": false,
    "files_deleted": "Deletion history is defined by DELETE_MANIFEST.txt; this manifest stores no phase-specific count."
  },
  "protected_runtime_paths": [
    "index.html",
    "studio/index.html",
    "bootstrap-core.js",
    "bootstrap-ui.js",
    "bootstrap-ui.css",
    "export-core.js",
    "jszip.min.js",
    "ai-gateway.js",
    "manifest.webmanifest",
    "sw.js",
    "icon-192.png",
    "icon-512.png",
    "project-data.json",
    "package_manifest.json",
    "package-build.json"
  ],
  "root_document_patterns": [
    "BUILD*.md",
    "RELEASE_NOTES*.md",
    "DECISION_*.md",
    "*_VERIFICATION.md",
    "*_REPORT*.md",
    "*_PLAN*.md"
  ],
  "allowed_root_runtime_extensions": [
    ".html",
    ".js",
    ".css",
    ".json",
    ".webmanifest",
    ".png",
    ".txt"
  ],
  "notes": "Runtime protection contract only. Deletion authorization is controlled separately by DELETE_MANIFEST.txt.",
  "forbidden_runtime_references": [
    "archive/retired/",
    "apps/game/",
    "apps/studio/",
    "formal-v03-legacy/"
  ]
}
