{
  "schema_version": 1,
  "package_build": 444,
  "purpose": "Separate repository-root runtime surface from historical and governance documents without moving or deleting files.",
  "policy": {
    "runtime_paths_are_protected": true,
    "historical_root_documents_are_retained": true,
    "runtime_files_moved": false,
    "files_deleted": 0
  },
  "protected_runtime_paths": [
    "index.html",
    "studio/index.html",
    "apps/index.html",
    "apps/game/index.html",
    "apps/studio/index.html",
    "bootstrap-core.js",
    "bootstrap-ui.js",
    "bootstrap-ui.css",
    "export-core.js",
    "jszip.min.js",
    "ai-gateway.js",
    "manifest.webmanifest",
    "sw.js",
    "icon-192.png",
    "icon-512.png",
    "project-data.json",
    "package_manifest.json",
    "package-build.json",
    "VERSION.txt"
  ],
  "root_document_patterns": [
    "BUILD*.md",
    "RELEASE_NOTES*.md",
    "DECISION_*.md",
    "*_VERIFICATION.md",
    "*_REPORT*.md",
    "*_PLAN*.md"
  ],
  "allowed_root_runtime_extensions": [
    ".html",
    ".js",
    ".css",
    ".json",
    ".webmanifest",
    ".png",
    ".txt"
  ],
  "notes": "Classification only. Historical root documents may be moved in a later build after compatibility review."
}
