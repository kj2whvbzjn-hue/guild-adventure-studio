{
  "schema_version": 1,
  "purpose": "Protect repository-root runtime files while allowing obsolete historical documents and retired source copies to be removed.",
  "policy": {
    "runtime_paths_are_protected": true,
    "historical_root_documents_are_retained": false,
    "runtime_files_moved": false,
    "files_deleted": "phase1+phase2 cleanup; see reports"
  },
  "protected_runtime_paths": [
    "index.html",
    "studio/index.html",
    "bootstrap-core.js",
    "bootstrap-ui.js",
    "bootstrap-ui.css",
    "export-core.js",
    "jszip.min.js",
    "ai-gateway.js",
    "manifest.webmanifest",
    "sw.js",
    "icon-192.png",
    "icon-512.png",
    "project-data.json",
    "package_manifest.json",
    "package-build.json"
  ],
  "root_document_patterns": [
    "BUILD*.md",
    "RELEASE_NOTES*.md",
    "DECISION_*.md",
    "*_VERIFICATION.md",
    "*_REPORT*.md",
    "*_PLAN*.md"
  ],
  "allowed_root_runtime_extensions": [
    ".html",
    ".js",
    ".css",
    ".json",
    ".webmanifest",
    ".png",
    ".txt"
  ],
  "notes": "Runtime protection contract only. Completed work records, historical documents, and retired release archives are not required."
}
