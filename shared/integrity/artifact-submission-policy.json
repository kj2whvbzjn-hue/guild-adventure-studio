{
  "schema_version": 1,
  "policy_id": "ARTIFACT-SUBMISSION-ZIP-001",
  "default": "zip_required_for_every_uploaded_artifact",
  "scope": [
    "source_code",
    "management_documents",
    "specifications",
    "inspection_results",
    "images",
    "pdf",
    "spreadsheets",
    "single_documents",
    "patches",
    "reference_materials"
  ],
  "exceptions": {
    "allowed_only_when": "user_explicitly_requests_non_zip_for_that_artifact"
  },
  "ai_requirements": {
    "must_read": [
      "AI_WORK_RULES.md",
      "docs/operations/ARTIFACT_SUBMISSION_POLICY.md"
    ],
    "must_embed_in_ai_context": true,
    "fail_closed_when_rules_unavailable": true,
    "single_final_zip": true,
    "individual_files_as_final_artifact": false
  }
}
