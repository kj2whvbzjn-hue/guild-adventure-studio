{
  "schema_version": 1,
  "default_class": "persistent",
  "classes": {
    "persistent": {
      "description": "GitHubソースへ永続保存しpackage manifestへ登録",
      "exact_paths": [
        ".gitignore"
      ],
      "patterns": []
    },
    "game_data": {
      "description": "正式Gameデータ。Studio更新ではGitHubへ配置せず、Gameデータ配置だけがExport/を更新する",
      "exact_paths": [],
      "patterns": [
        "Export/**"
      ]
    },
    "update_only": {
      "description": "更新ZIPだけで使用しGitHubへ配置しない",
      "exact_paths": [
        "DELETE_MANIFEST.txt",
        "DELETE_APPROVAL.json",
        "studio-update.json"
      ],
      "patterns": []
    },
    "artifact": {
      "description": "提出物・検査出力・生成ZIP",
      "exact_paths": [],
      "patterns": [
        "*.zip",
        "reports/**",
        "release-output/**",
        "README_実行手順*.md",
        "*_preview.zip",
        "*_inspection-report.json"
      ]
    },
    "temporary": {
      "description": "キャッシュ・一時ファイル",
      "exact_paths": [],
      "patterns": [
        "**/__pycache__/**",
        "**/*.pyc",
        "**/*.pyo",
        "**/*.tmp",
        "**/*.bak",
        "**/*.swp",
        ".pytest_cache/**",
        ".mypy_cache/**",
        ".ruff_cache/**"
      ]
    },
    "external_control": {
      "description": "人間が更新成果物とは独立して与える承認入力。ソース/更新ZIPへ同梱禁止",
      "exact_paths": [
        "TEST_CHANGE_APPROVAL.json"
      ],
      "patterns": []
    }
  },
  "rules": {
    "source_allowed_classes": [
      "persistent",
      "game_data"
    ],
    "update_allowed_classes": [
      "persistent",
      "update_only"
    ],
    "studio_upload_classes": [
      "persistent"
    ],
    "package_manifest_classes": [
      "persistent"
    ],
    "github_download_baseline_classes": [
      "persistent"
    ],
    "require_update_metadata": "studio-update.json",
    "require_update_delete_manifest": "DELETE_MANIFEST.txt",
    "reject_outer_submission_zip": true
  }
}
