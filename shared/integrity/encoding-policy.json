{
  "schema_version": 1,
  "policy": "utf8_required_iphone_compatible",
  "text_encoding": "utf-8",
  "csv": {
    "bom_required": true,
    "recommended_newline": "crlf"
  },
  "html": {
    "meta_charset_required": "utf-8"
  },
  "zip": {
    "unicode_normalization": "NFC",
    "utf8_filename_flag_required_for_non_ascii": true,
    "prefer_ascii_entry_names": true,
    "escaped_unicode_filename_pattern_forbidden": "#U[0-9A-Fa-f]{4,6}"
  },
  "legacy_exceptions": [],
  "studio_upload_filename_repair_required": false,
  "studio_upload_nfc_guard_required": true,
  "escaped_unicode_input_canonicalization": "forbidden_no_guessing",
  "escaped_unicode_handling": "record_evidence_and_stop",
  "zip_filename_decoding": "utf8-flag-strict-or-valid-unicode-path-extra-field",
  "unicode_path_extra_field": "parse-0x7075-version1-and-verify-raw-name-crc32",
  "unflagged_non_ascii_without_valid_unicode_path": "reject",
  "library_name_cross_check_required": true,
  "raw_central_directory_name_evidence_required": true,
  "ascii_only_path_prefixes": [
    "docs/equipment/"
  ]
}
