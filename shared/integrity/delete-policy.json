{
  "schema_version": 1,
  "default_action": "deny",
  "manifest_scope": "single_update_only",
  "max_entries_per_update": 20,
  "approval_file": "DELETE_APPROVAL.json",
  "approval_required_when_entries_exist": true,
  "allow_general_instruction_as_approval": false,
  "require_non_delete_alternative": true,
  "require_impact": true,
  "require_recovery": true,
  "forbid_policy_change_with_deletion": true,
  "protected_exact_paths": [
    "package_manifest.json",
    "project-data.json",
    "studio-update.json",
    "DELETE_MANIFEST.txt",
    "DELETE_APPROVAL.json",
    "shared/integrity/delete-policy.json"
  ],
  "protected_prefixes": [
    "game/",
    "studio/",
    "Export/",
    "schemas/",
    "tests/",
    "shared/integrity/",
    "tools/integrity/",
    "tools/inspection/"
  ],
  "allowed_categories": [
    "temporary_generated",
    "exact_duplicate_unreferenced",
    "migration_complete",
    "misplaced_file",
    "broken_unreferenced",
    "security_removal"
  ],
  "deletion_control_paths": [
    "studio/index.html",
    "tools/integrity/check-delete-manifest.py",
    "shared/integrity/delete-policy.json",
    "docs/operations/DELETION_POLICY.md",
    "docs/operations/DELETE_WORKFLOW.md"
  ]
}
