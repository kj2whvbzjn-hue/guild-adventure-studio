{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ga-v9://schemas/skill.schema.json",
  "title": "Guild Adventure V9 Skill Data",
  "type": "object",
  "required": [
    "schemaVersion",
    "build",
    "status",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build": {
      "type": "integer",
      "minimum": 399
    },
    "status": {
      "enum": [
        "development",
        "adopted"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "required": [
        "ja"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "subject",
        "type"
      ],
      "properties": {
        "subject": {
          "enum": [
            "actor",
            "target"
          ]
        },
        "type": {
          "enum": [
            "has_tag",
            "not_has_tag",
            "stack_at_least"
          ]
        },
        "tagId": {
          "type": "string",
          "minLength": 1
        },
        "stackId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "subject",
        "type"
      ],
      "properties": {
        "subject": {
          "enum": [
            "actor",
            "target"
          ]
        },
        "type": {
          "enum": [
            "add_tag",
            "remove_tag",
            "add_stack",
            "consume_stack"
          ]
        },
        "tagId": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            }
          }
        },
        "stackId": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            }
          }
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status",
        "name",
        "kind",
        "mpCost",
        "cooldown",
        "target",
        "execution"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "development",
            "adopted",
            "deprecated"
          ]
        },
        "name": {
          "$ref": "#/$defs/localizedName"
        },
        "kind": {
          "const": "interaction"
        },
        "mpCost": {
          "type": "number",
          "minimum": 0
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "enum": [
            "self",
            "ally",
            "enemy"
          ]
        },
        "execution": {
          "type": "object",
          "required": [
            "conditionMode",
            "conditions",
            "costs",
            "effects"
          ],
          "additionalProperties": false,
          "properties": {
            "conditionMode": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            },
            "costs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/operation"
              }
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/operation"
              }
            }
          }
        }
      }
    }
  },
  "$comment": "TASK-FRM-004: Current Formal target.range admission is SINGLE/FRONT/BACK/RANDOM/ALL. PIERCE is abolished and must be rejected by the Formal compiler/registry; this legacy interaction schema does not admit Formal range tokens."
}
