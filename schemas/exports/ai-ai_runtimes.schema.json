{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/ai-ai_runtimes.schema.json",
  "title": "ai/ai_runtimes.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "data_version", "program_id", "program_version", "compiler_version", "entry_instruction", "instructions", "source_map", "limits", "content_hash"],
    "properties": {
      "schema_version": {"type": "string", "minLength": 1},
      "data_version": {"type": "string", "minLength": 1},
      "program_id": {"type": "string", "minLength": 1},
      "program_version": {"type": "integer", "minimum": 1},
      "compiler_version": {"type": "string", "minLength": 1},
      "entry_instruction": {"type": "string", "minLength": 1},
      "instructions": {"type": "array"},
      "source_map": {"type": "object"},
      "limits": {"type": "object"},
      "content_hash": {"type": "string", "minLength": 64}
    },
    "additionalProperties": false
  }
}
