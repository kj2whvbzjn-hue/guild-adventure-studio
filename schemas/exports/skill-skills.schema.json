{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/skill-skills.schema.json",
  "title": "skill/skills.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "power": {
        "type": "number",
        "minimum": 0
      },
      "target": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string"
          },
          "range": {
            "enum": [
              "SINGLE",
              "FRONT",
              "BACK",
              "RANDOM",
              "ALL"
            ]
          },
          "randomCount": {
            "type": "integer",
            "minimum": 1
          },
          "excludeSelf": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "$comment": "TASK-FRM-004: PIERCE is abolished from Current Formal target.range admission."
}
