{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/system-drop_tables.schema.json",
  "title": "system/drop_tables.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "status": {
        "type": "string"
      },
      "params": {
        "type": "object"
      },
      "groups": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "rolls": {
              "type": "integer",
              "minimum": 0
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rewardEntry"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/rewardEntry"
        }
      }
    },
    "additionalProperties": true
  },
  "$defs": {
    "rewardEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gold",
            "equipment",
            "item",
            "stone",
            "material"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "base_weight": {
          "type": "number",
          "minimum": 0
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rarity": {
          "type": "string"
        },
        "scaling_mode": {
          "type": "string",
          "enum": [
            "none",
            "amount",
            "quality",
            "both"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "count": {
          "type": "number",
          "minimum": 0
        },
        "amount_min": {
          "type": "number",
          "minimum": 0
        },
        "amount_max": {
          "type": "number",
          "minimum": 0
        },
        "equipment_id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "stone_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "resource_kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
