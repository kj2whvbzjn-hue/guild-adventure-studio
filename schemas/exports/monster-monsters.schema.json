{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/monster-monsters.schema.json",
  "title": "monster/monsters.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "default_formation_position",
      "formalAiBinding"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "drop_table_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "drop_table_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "params": {
        "type": "object",
        "properties": {
          "drop_table_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "drop_table_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "default_formation_position": {
        "type": "string",
        "enum": [
          "FRONTLINE",
          "BACKLINE"
        ],
        "default": "FRONTLINE"
      },
      "formalAiBinding": {
        "type": "object",
        "required": [
          "program_id",
          "layout_id"
        ],
        "properties": {
          "program_id": {
            "type": "string",
            "pattern": "^AIP-[0-9]{4}$"
          },
          "layout_id": {
            "type": "string",
            "pattern": "^AIL-[0-9]{4}$"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": true
  }
}
