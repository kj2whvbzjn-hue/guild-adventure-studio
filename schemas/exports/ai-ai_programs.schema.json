{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/ai-ai_programs.schema.json",
  "title": "ai/ai_programs.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "data_version", "id", "name", "version", "status", "entry_node_id", "nodes", "edges", "subroutines"],
    "properties": {
      "schema_version": {"type": "string", "minLength": 1},
      "data_version": {"type": "string", "minLength": 1},
      "id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "version": {"type": "integer", "minimum": 1},
      "status": {"type": "string", "enum": ["valid"]},
      "entry_node_id": {"type": "string", "minLength": 1},
      "nodes": {"type": "array"},
      "edges": {"type": "array"},
      "subroutines": {"type": "array"}
    },
    "additionalProperties": true
  }
}
