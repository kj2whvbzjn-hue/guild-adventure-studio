{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/event-events.schema.json",
  "title": "event/events.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "usage",
      "type"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "usage": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "story",
              "random",
              "common"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "story",
                "random",
                "common"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "battle",
          "exploration",
          "choice",
          "special"
        ]
      },
      "group": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "conditions": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array"
          }
        ]
      },
      "intensity": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high",
          "extreme",
          ""
        ]
      },
      "generation_profile_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "random_base_weight": {
        "type": "number",
        "minimum": 0
      },
      "enabled": {
        "type": "boolean"
      },
      "reward_table_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "reward_table_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "status": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "results": {
        "type": "string"
      },
      "required_flags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "set_flags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
