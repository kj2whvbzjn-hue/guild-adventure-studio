{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/event-events.schema.json",
  "title": "event/events.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "usage": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "story",
              "random",
              "common"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "story",
                "random",
                "common"
              ]
            },
            "uniqueItems": true
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "battle",
          "exploration",
          "choice",
          "special",
          "story",
          "reward",
          "system"
        ]
      },
      "group": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "conditions": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array"
          }
        ]
      },
      "intensity": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high",
          "extreme",
          ""
        ]
      },
      "generation_profile_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "random_base_weight": {
        "type": "number",
        "minimum": 0
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "additionalProperties": true
  }
}
