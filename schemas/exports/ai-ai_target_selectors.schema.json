{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/ai-ai_target_selectors.schema.json",
  "title": "ai/ai_target_selectors.json data",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "schema_version",
      "id",
      "name",
      "evaluator",
      "parameter_schema",
      "tags",
      "enabled"
    ],
    "properties": {
      "schema_version": {
        "const": "2.0.0"
      },
      "id": {
        "type": "string",
        "pattern": "^ATS-[A-Za-z0-9_.-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "deprecated",
          "disabled"
        ]
      },
      "evaluator": {
        "type": "string",
        "minLength": 1,
        "pattern": "^selector\\.[A-Za-z0-9_.-]+$"
      },
      "parameter_schema": {
        "type": "object"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "enabled": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
