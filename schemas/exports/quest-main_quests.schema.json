                "type": "object",
                "required": [
                  "kind",
                  "order",
                  "failure_policy"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "fixed_event",
                      "random_event"
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "failure_policy": {
                    "enum": [
                      "continue",
                      "quest_fail"
                    ]
                  },
                  "event_id": {
                    "type": "string"
                  },
