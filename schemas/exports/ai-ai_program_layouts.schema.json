{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/ai-ai_program_layouts.schema.json",
  "title": "ai/ai_program_layouts.json data",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "schema_version",
      "data_version",
      "layout_id",
      "program_id",
      "width",
      "height",
      "chips",
      "extensions"
    ],
    "properties": {
      "schema_version": {
        "const": "2.0.0"
      },
      "data_version": {
        "type": "string",
        "minLength": 1
      },
      "layout_id": {
        "type": "string",
        "pattern": "^AIL-[0-9]+$"
      },
      "program_id": {
        "type": "string",
        "minLength": 1
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "chips": {
        "type": "array",
        "items": {
          "$ref": "#/items/$defs/chip"
        }
      },
      "extensions": {
        "type": "array",
        "items": {
          "$ref": "#/items/$defs/extension"
        }
      }
    },
    "additionalProperties": false,
    "$defs": {
      "rotation": {
        "type": "integer",
        "enum": [
          0,
          90,
          180,
          270
        ]
      },
      "chip": {
        "type": "object",
        "required": [
          "instance_id",
          "x",
          "y",
          "rotation"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "rotation": {
            "$ref": "#/items/$defs/rotation"
          }
        },
        "additionalProperties": false
      },
      "extension": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "shape",
          "rotation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "shape": {
            "enum": [
              "straight",
              "corner"
            ]
          },
          "rotation": {
            "$ref": "#/items/$defs/rotation"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
