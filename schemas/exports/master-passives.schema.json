{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exports/master-passives.schema.json",
  "title": "master/passives.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "status",
      "passiveSeriesId",
      "params",
      "runtimeContracts"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^PAS-[0-9]{4}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "passiveSeriesId": {
        "type": "string",
        "minLength": 1
      },
      "params": {
        "type": "object",
        "required": [
          "ability_conditions",
          "mod_ids",
          "effect_ids",
          "combat_capabilities"
        ],
        "properties": {
          "ability_conditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "mod_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "combat_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      },
      "description": {
        "type": "string"
      },
      "runtimeContracts": {
        "type": "object",
        "required": [
          "schemaVersion",
          "passiveSeriesId",
          "abilityRequirementContracts",
          "thresholdConsumption",
          "modifierRefs"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "registryPhase": {
            "type": "string"
          },
          "passiveSeriesId": {
            "type": "string",
            "minLength": 1
          },
          "abilityRequirementContracts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "thresholdConsumption": {
            "type": "object",
            "required": [
              "byStat",
              "total"
            ],
            "properties": {
              "byStat": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 110
              }
            },
            "additionalProperties": true
          },
          "triggerContract": {
            "type": [
              "object",
              "null"
            ]
          },
          "targetContract": {
            "type": [
              "object",
              "null"
            ]
          },
          "executionContract": {
            "type": [
              "object",
              "null"
            ]
          },
          "modifierRefs": {
            "type": "object",
            "required": [
              "modIds",
              "effectIds",
              "combatCapabilities"
            ],
            "properties": {
              "modIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "effectIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "combatCapabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
