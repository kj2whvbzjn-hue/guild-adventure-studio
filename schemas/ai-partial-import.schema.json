{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gk://schemas/ai-partial-import.schema.json",
  "title": "GK Studio AI Partial Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "project_id", "dataset", "operations", "metadata"],
  "properties": {
    "format": {"const": "GKS_AI_PARTIAL_IMPORT"},
    "version": {"const": "1.0.0-draft"},
    "project_id": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "id", "record"],
            "properties": {
              "op": {"const": "CREATE"},
              "id": {"type": "string", "minLength": 1},
              "record": {"type": "object"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "id", "record", "expected_record_hash"],
            "properties": {
              "op": {"const": "UPDATE"},
              "id": {"type": "string", "minLength": 1},
              "record": {"type": "object"},
              "expected_record_hash": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["package_hash", "hash_algorithm"],
      "properties": {
        "package_hash": {"type": "string"},
        "hash_algorithm": {"const": "SHA-256"},
        "generated_at": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "base": {"type": "object", "additionalProperties": true}
  }
}
