{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-master-snapshot.schema.json",
  "title": "Formal AI V2 master snapshot data",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "data_version",
    "nodes",
    "target_selectors"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "node_type"
        ],
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          },
          "id": {
            "pattern": "^(AIS|AIC|AIA)-"
          },
          "node_type": {
            "enum": [
              "search",
              "condition",
              "action"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "target_selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          },
          "id": {
            "pattern": "^ATS-"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
