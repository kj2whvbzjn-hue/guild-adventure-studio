{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-runtime.schema.json",
  "title": "Compiled Formal AI V2 runtime program",
  "type": "object",
  "required": [
    "schema_version",
    "data_version",
    "program_id",
    "program_version",
    "compiler_version",
    "entry_instruction",
    "instructions",
    "source_map",
    "limits",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "program_version": {
      "type": "integer",
      "minimum": 1
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "entry_instruction": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instruction"
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source_map_entry"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_steps",
        "max_subroutine_depth"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_subroutine_depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_map_entry": {
      "type": "object",
      "required": [
        "origin_part_id",
        "source_node_id"
      ],
      "properties": {
        "origin_part_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "instruction": {
      "type": "object",
      "required": [
        "instruction_id",
        "op",
        "origin_part_id",
        "source_node_id",
        "params"
      ],
      "properties": {
        "instruction_id": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "SEARCH",
            "CONDITION",
            "ACTION",
            "CALL",
            "RETURN",
            "WAIT",
            "END"
          ]
        },
        "origin_part_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "master_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluator": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_found": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_not_found": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_true": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_false": {
          "type": [
            "string",
            "null"
          ]
        },
        "subroutine_id": {
          "type": "string",
          "minLength": 1
        },
        "entry_instruction": {
          "type": "string",
          "minLength": 1
        },
        "return_instruction_id": {
          "type": "string",
          "minLength": 1
        },
        "target_selector": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/target_selector"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "target_selector": {
      "type": "object",
      "required": [
        "selector_id",
        "params"
      ],
      "properties": {
        "selector_id": {
          "type": "string",
          "pattern": "^ATS-[A-Za-z0-9_.-]+$"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
