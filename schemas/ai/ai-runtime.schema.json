{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-runtime.schema.json",
  "title": "Compiled Studio AI runtime program",
  "type": "object",
  "required": ["schema_version", "data_version", "program_id", "program_version", "compiler_version", "entry_instruction", "instructions", "source_map", "limits", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "data_version": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_version": {"type": "integer", "minimum": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "entry_instruction": {"type": "string", "minLength": 1},
    "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instruction"}},
    "source_map": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "limits": {
      "type": "object",
      "required": ["max_steps", "max_subroutine_depth"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "max_subroutine_depth": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "instruction": {
      "type": "object",
      "required": ["instruction_id", "op", "master_node_id", "evaluator", "params"],
      "properties": {
        "instruction_id": {"type": "string", "minLength": 1},
        "op": {"type": "string", "enum": ["CONDITION", "TARGET", "ACTION", "CALL", "WAIT", "END"]},
        "master_node_id": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "next": {"type": ["string", "null"]},
        "on_true": {"type": ["string", "null"]},
        "on_false": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
