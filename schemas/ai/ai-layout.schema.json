{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-layout.schema.json",
  "title": "Player-authored AI board layout",
  "type": "object",
  "required": ["layout_version", "layout_id", "program_id", "width", "height", "chips", "extensions"],
  "properties": {
    "layout_version": {"const": 1},
    "layout_id": {"type": "string", "minLength": 1, "pattern": "^AIL-[0-9]+$"},
    "program_id": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "chips": {
      "type": "array",
      "items": {"$ref": "#/$defs/chip"}
    },
    "extensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/extension"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rotation": {"type": "integer", "enum": [0, 90, 180, 270]},
    "chip": {
      "type": "object",
      "required": ["instance_id", "x", "y", "rotation"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "rotation": {"$ref": "#/$defs/rotation"}
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": ["id", "x", "y", "shape", "rotation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "shape": {"type": "string", "enum": ["straight", "corner"]},
        "rotation": {"$ref": "#/$defs/rotation"}
      },
      "additionalProperties": false
    }
  }
}
