{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-trace.schema.json",
  "title": "Formal AI V2 decision trace",
  "type": "object",
  "required": [
    "schema_version",
    "data_version",
    "battle_id",
    "program_id",
    "program_version",
    "actor_id",
    "seed",
    "events",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "battle_id": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "program_version": {
      "type": "integer",
      "minimum": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "string",
        "integer"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "selected",
            "wait",
            "failed",
            "step_limit"
          ]
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "tick",
        "phase",
        "step",
        "instruction_id",
        "origin_part_id",
        "source_node_id",
        "event_type",
        "result",
        "details"
      ],
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "reservation",
            "execution",
            "rethink"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "instruction_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_part_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "enum": [
            "search",
            "condition",
            "action",
            "selector",
            "rng",
            "branch",
            "call",
            "wait",
            "end",
            "error"
          ]
        },
        "result": {
          "enum": [
            "found",
            "not_found",
            "true",
            "false",
            "selected",
            "skipped",
            "entered",
            "returned",
            "failed",
            "completed"
          ]
        },
        "rng_stream": {
          "enum": [
            "AI_DECISION",
            "BATTLE_EXECUTION"
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
