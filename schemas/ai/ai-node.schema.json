{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ai/ai-node.schema.json",
  "title": "Studio AI master node contract",
  "type": "object",
  "required": [
    "id",
    "name",
    "node_type",
    "status",
    "data_version",
    "evaluator",
    "ports",
    "parameter_schema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(AIC|AIT|AIA)-[A-Za-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "node_type": {
      "type": "string",
      "enum": [
        "condition",
        "target",
        "action"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "disabled"
      ]
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "ports": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      },
      "additionalProperties": false
    },
    "parameter_schema": {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "unlock": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "port": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "data_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "flow",
            "value"
          ]
        },
        "data_type": {
          "type": "string",
          "enum": [
            "flow",
            "boolean",
            "number",
            "string",
            "tag",
            "target",
            "action"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "node_type": {
            "const": "condition"
          }
        },
        "required": [
          "node_type"
        ]
      },
      "then": {
        "properties": {
          "ports": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "in"
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "true"
                      }
                    }
                  },
                  {
                    "properties": {
                      "id": {
                        "const": "false"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "node_type": {
            "const": "target"
          }
        },
        "required": [
          "node_type"
        ]
      },
      "then": {
        "properties": {
          "ports": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "in"
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "next"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "node_type": {
            "const": "action"
          }
        },
        "required": [
          "node_type"
        ]
      },
      "then": {
        "properties": {
          "ports": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "in"
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
