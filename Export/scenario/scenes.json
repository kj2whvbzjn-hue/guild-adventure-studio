{
  "schema_version": "1.0.0",
  "data_version": "demo-0.1.2",
  "generated_at": "2026-08-16T01:20:39.291Z",
  "generated_by": "GK Studio vGKS-B593",
  "data": [
    {
      "id": "SCN-0001",
      "no": 1,
      "title": "前",
      "summary": "王子アルフレッドが身分を隠し、新兵として近衛騎士団へ向かう決意を固める。",
      "status": "draft",
      "dialogues": [
        {
          "id": "DLG-0001",
          "no": 1,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "春の朝日が王都アルディアの白い城壁を照らしていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0002",
          "no": 2,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王都は既に目を覚ましている。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0003",
          "no": 3,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "城下町の市場では商人たちが店を開き、石畳の通りには荷車の音が響く。焼きたてのパンの香りが風に乗り、人々の活気ある声が城の高台にまで届いていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0004",
          "no": 4,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "その光景を、城の一室から静かに見下ろしている青年がいた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0005",
          "no": 5,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッド。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0006",
          "no": 6,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルディア王国第一王子。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0007",
          "no": 7,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王位継承者。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0008",
          "no": 8,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "だが今日から彼は王子ではなくなる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0009",
          "no": 9,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "少なくとも表向きは。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0010",
          "no": 10,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "窓辺に立つアルフレッドは、遠くに広がる草原へ視線を向けた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0011",
          "no": 11,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王都を取り囲む広大な緑の大地。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0012",
          "no": 12,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "春風に揺れる草はまるで波のようにうねり、朝露を受けて銀色に輝いている。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0013",
          "no": 13,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "綺麗だな……",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0014",
          "no": 14,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "思わず口から漏れた言葉だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0015",
          "no": 15,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "背後から控えめな咳払いが聞こえる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0016",
          "no": 16,
          "status": "draft",
          "speaker": "グレイ",
          "text": "殿下。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0017",
          "no": 17,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "振り返ると侍従長のグレイが立っていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0018",
          "no": 18,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "幼い頃からアルフレッドを見守ってきた老人である。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0019",
          "no": 19,
          "status": "draft",
          "speaker": "グレイ",
          "text": "本当に行かれるのですか？",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0020",
          "no": 20,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "何度も聞いた問いだった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0021",
          "no": 21,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは苦笑する。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0022",
          "no": 22,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "まだ心配しているのか。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0023",
          "no": 23,
          "status": "draft",
          "speaker": "グレイ",
          "text": "当然です。王子が身分を隠して騎士団に入隊など前代未聞です。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0024",
          "no": 24,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "父上も認めてくれた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0025",
          "no": 25,
          "status": "draft",
          "speaker": "グレイ",
          "text": "国王陛下は昔から無茶を良しとされる方ですので。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0026",
          "no": 26,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "グレイは深いため息をついた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0027",
          "no": 27,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは机の上に置かれた王族用の上着を見つめる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0028",
          "no": 28,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "胸には王家の紋章。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0029",
          "no": 29,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "生まれた時から身に着けてきた誇り。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0030",
          "no": 30,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "だが今日はそれを着ない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0031",
          "no": 31,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "代わりに置かれているのは質素な革鎧だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0032",
          "no": 32,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "新兵支給品。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0033",
          "no": 33,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "誰も王子だとは思わない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0034",
          "no": 34,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "王になる前に知りたいんだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0035",
          "no": 35,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "民が何を考え、騎士が何を守り、兵士が何を恐れているのか。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0036",
          "no": 36,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "本だけでは分からない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0037",
          "no": 37,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "だから俺は行く。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0038",
          "no": 38,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "グレイはしばらく黙っていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0039",
          "no": 39,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "やがて観念したように微笑む。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0040",
          "no": 40,
          "status": "draft",
          "speaker": "グレイ",
          "text": "幼い頃から変わりませんな。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0041",
          "no": 41,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "そうか？",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0042",
          "no": 42,
          "status": "draft",
          "speaker": "グレイ",
          "text": "ええ。決めたら絶対に曲げない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0043",
          "no": 43,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは笑った。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0044",
          "no": 44,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "その時、扉がノックされた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0045",
          "no": 45,
          "status": "draft",
          "speaker": "レオン",
          "text": "失礼します。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0046",
          "no": 46,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "入ってきたのは近衛騎士団長レオンだった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0047",
          "no": 47,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "長身で屈強な男。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0048",
          "no": 48,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王国最強と称される騎士であり、アルフレッドの剣術の師でもある。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0049",
          "no": 49,
          "status": "draft",
          "speaker": "レオン",
          "text": "準備はできたか。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0050",
          "no": 50,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "もちろん。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0051",
          "no": 51,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "レオンは頷く。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0052",
          "no": 52,
          "status": "draft",
          "speaker": "レオン",
          "text": "ならば行くぞ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0053",
          "no": 53,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは王族のマントを脱いだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0054",
          "no": 54,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "そして革鎧を身に着ける。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0055",
          "no": 55,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "鏡の前に立つ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0056",
          "no": 56,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "そこに映るのは王子ではなかった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0057",
          "no": 57,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "一人の若い兵士だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0058",
          "no": 58,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "行ってきます。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0059",
          "no": 59,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "誰に言うでもなく呟く。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0060",
          "no": 60,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "そしてアルフレッドは王城を後にした。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        }
      ],
      "created_at": "2026-08-14T06:50:00.000Z",
      "updated_at": "2026-08-14T06:50:00.000Z",
      "chapter_id": "CHP-0001",
      "section_id": "SEC-0001"
    },
    {
      "id": "SCN-0002",
      "no": 2,
      "title": "中",
      "summary": "近衛騎士団本部で新兵アルフとして迎えられ、同期のランスと出会う。",
      "status": "draft",
      "dialogues": [
        {
          "id": "DLG-0061",
          "no": 1,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "近衛騎士団本部は王都の南門近くにあった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0062",
          "no": 2,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "巨大な訓練場。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0063",
          "no": 3,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "整然と並ぶ兵舎。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0064",
          "no": 4,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "鍛冶場からは金属を打つ音が響いている。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0065",
          "no": 5,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王国中から集められた精鋭たちの拠点だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0066",
          "no": 6,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "レオンは歩きながら低い声で言う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0067",
          "no": 7,
          "status": "draft",
          "speaker": "レオン",
          "text": "ここから先、お前は王子ではない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0068",
          "no": 8,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "分かっている。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0069",
          "no": 9,
          "status": "draft",
          "speaker": "レオン",
          "text": "お前の正体を知るのは私だけだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0070",
          "no": 10,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "父上も母上も了承済みだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0071",
          "no": 11,
          "status": "draft",
          "speaker": "レオン",
          "text": "だからこそだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0072",
          "no": 12,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "レオンは立ち止まった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0073",
          "no": 13,
          "status": "draft",
          "speaker": "レオン",
          "text": "甘えは許さん。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0074",
          "no": 14,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは真っ直ぐ見返す。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0075",
          "no": 15,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "望むところだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0076",
          "no": 16,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "レオンは口元だけで笑った。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0077",
          "no": 17,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "二人が訓練場へ入ると、新兵たちの視線が集まる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0078",
          "no": 18,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "その中から一人の青年が近付いてきた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0079",
          "no": 19,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "茶色の髪。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0080",
          "no": 20,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "人懐っこい笑顔。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0081",
          "no": 21,
          "status": "draft",
          "speaker": "ランス",
          "text": "お、新入りか？",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0082",
          "no": 22,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは少し戸惑う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0083",
          "no": 23,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王族として育った彼は、こんな気軽な話しかけ方をされた経験がなかった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0084",
          "no": 24,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "そうだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0085",
          "no": 25,
          "status": "draft",
          "speaker": "ランス",
          "text": "俺はランス。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0086",
          "no": 26,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "青年は手を差し出した。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0087",
          "no": 27,
          "status": "draft",
          "speaker": "ランス",
          "text": "よろしくな。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0088",
          "no": 28,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは一瞬迷ったあと、その手を握る。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0089",
          "no": 29,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "アルフだ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0090",
          "no": 30,
          "status": "draft",
          "speaker": "ランス",
          "text": "おう、よろしくアルフ！",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0091",
          "no": 31,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "あまりにも自然な態度だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0092",
          "no": 32,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "肩書も身分も関係ない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0093",
          "no": 33,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "ただの同期として接している。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0094",
          "no": 34,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは少し嬉しくなった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0095",
          "no": 35,
          "status": "draft",
          "speaker": "ランス",
          "text": "なんだよ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0096",
          "no": 36,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "いや。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0097",
          "no": 37,
          "status": "draft",
          "speaker": "ランス",
          "text": "変なやつだな。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0098",
          "no": 38,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "二人は笑う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0099",
          "no": 39,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "その光景をレオンが遠くから見ていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0100",
          "no": 40,
          "status": "draft",
          "speaker": "レオン",
          "text": "良い経験になるだろう。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0101",
          "no": 41,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "団長は小さく呟いた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        }
      ],
      "created_at": "2026-08-14T06:50:00.000Z",
      "updated_at": "2026-08-14T06:50:00.000Z",
      "chapter_id": "CHP-0001",
      "section_id": "SEC-0001"
    },
    {
      "id": "SCN-0003",
      "no": 3,
      "title": "後",
      "summary": "初日の訓練を終え、翌日の実戦形式訓練が告げられる。",
      "status": "draft",
      "dialogues": [
        {
          "id": "DLG-0102",
          "no": 1,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "夕方。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0103",
          "no": 2,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "訓練が終わった頃には空が赤く染まっていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0104",
          "no": 3,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "訓練場の向こうには広大な草原が広がっている。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0105",
          "no": 4,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "風が吹くたび草の海が揺れる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0106",
          "no": 5,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは兵舎の外に立っていた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0107",
          "no": 6,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "王城で見る景色とは違う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0108",
          "no": 7,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "同じ王都でも全く違う世界だった。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0109",
          "no": 8,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "隣にランスがやってくる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0110",
          "no": 9,
          "status": "draft",
          "speaker": "ランス",
          "text": "明日から地獄だぞ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0111",
          "no": 10,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "そんなに厳しいのか。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0112",
          "no": 11,
          "status": "draft",
          "speaker": "ランス",
          "text": "教官ガレスを知らないのか？",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0113",
          "no": 12,
          "status": "draft",
          "speaker": "アルフレッド",
          "text": "知らない。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0114",
          "no": 13,
          "status": "draft",
          "speaker": "ランス",
          "text": "終わったな。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0115",
          "no": 14,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "ランスは真顔で言った。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0116",
          "no": 15,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドは思わず笑う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0117",
          "no": 16,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "その時、訓練場の向こうから夕陽を背負ったレオンが歩いてきた。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0118",
          "no": 17,
          "status": "draft",
          "speaker": "レオン",
          "text": "新兵たち。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
