        },
        {
          "id": "DLG-0119",
          "no": 18,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "全員が振り返る。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0120",
          "no": 19,
          "status": "draft",
          "speaker": "レオン",
          "text": "明日は実戦形式の訓練を行う。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0121",
          "no": 20,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "ざわめきが起きる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0122",
          "no": 21,
          "status": "draft",
          "speaker": "レオン",
          "text": "騎士とは何か。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0123",
          "no": 22,
          "status": "draft",
          "speaker": "レオン",
          "text": "その意味を体で覚えろ。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0124",
          "no": 23,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "夕陽が沈んでいく。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0125",
          "no": 24,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "長い影が草原へ伸びる。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
        },
        {
          "id": "DLG-0126",
          "no": 25,
          "status": "draft",
          "speaker": "ナレーション",
          "text": "アルフレッドはその景色を見つめながら思った。",
          "stage_direction": "",
          "created_at": "2026-08-14T06:50:00.000Z",
          "updated_at": "2026-08-14T06:50:00.000Z"
