{
  "schema_version": 1,
  "aiGenerationRuleVersion": "G05-AI-GENERATION-V1",
  "phase": "G05",
  "purpose": "Deterministic Studio-side conversion from AI intent requests to Generic Skill numeric values. AI requests may choose structure and desired strength, but may not supply final battle numeric values.",
  "desired_strength": {
    "min": 0.1,
    "max": 1.0,
    "default": 0.65,
    "aliases": {
      "LOW": 0.45,
      "MEDIUM": 0.65,
      "HIGH": 0.85
    }
  },
  "defaults": {
    "trigger_type": "ON_USE",
    "trigger_scope": "SELF",
    "damage_type": "PHYSICAL",
    "remove_category": "STATUS",
    "remove_count": 1,
    "resource": "MP",
    "revive_mode": "RATE",
    "target_control_mode": "COVER",
    "target_control_trigger": "DIRECT_ATTACK",
    "target_control_priority": 0,
    "target_control_removable": true
  },
  "numeric_allocation": {
    "apply_power_share": 0.6,
    "apply_duration_share": 0.4,
    "minimum_power": 1,
    "minimum_duration": 1,
    "minimum_amount": 1,
    "minimum_hp": 1,
    "minimum_hp_rate": 0.01,
    "maximum_hp_rate": 1.0,
    "minimum_uses": 1
  },
  "forbidden_ai_numeric_fields": [
    "power",
    "amount",
    "duration",
    "hp",
    "hpRate",
    "uses",
    "priority",
    "mpCost",
    "cooldown",
    "activationPriority"
  ],
  "request_effect_structural_fields": {
    "DAMAGE": ["type", "damageType"],
    "HEAL": ["type"],
    "APPLY": ["type", "effectId"],
    "REMOVE": ["type", "category"],
    "RESOURCE_CHANGE": ["type", "resource", "direction"],
    "REVIVE": ["type", "mode"],
    "TARGET_CONTROL": ["type", "mode", "trigger", "removable", "lifetime"],
    "SPECIAL": ["type"]
  }
}
