        "control": "number",
        "step": "1",
        "min": 1
      },
      "all": {
        "label": "全解除",
        "control": "boolean"
      },
      "resource": {
        "label": "リソース",
        "control": "select"
      },
      "amount": {
        "label": "変化量",
        "control": "number",
        "step": "any"
      },
      "hp": {
        "label": "蘇生HP",
        "control": "number",
        "step": "1",
        "min": 1
