{
  "schema_version": 1,
  "phase": "FORMAL-SKILL-1",
  "runtime": {
    "effects": [
      "DAMAGE",
      "HEAL",
      "APPLY",
      "REMOVE",
      "RESOURCE_CHANGE",
      "REVIVE",
      "TARGET_CONTROL",
      "SPECIAL"
    ]
  },
  "authoring": {
    "schema_version": 1,
    "phase": "G05",
    "source_of_truth": "skill-registry.json",
    "purpose": "Formal Skill authoring definition shared by Studio, Skill Compiler, Skill Master, and Runtime.",
    "skill_required_fields": [
      "id",
      "name",
      "trigger.type",
      "target.side",
      "target.range",
      "effects"
    ],
    "effect_types": {
      "DAMAGE": {
        "label": "Damage",
        "enabled": true,
        "required_fields": [
          "power"
        ],
        "optional_fields": [
          "damageType",
          "elements"
        ]
      },
      "HEAL": {
        "label": "Heal",
        "enabled": true,
        "required_fields": [
          "power"
        ],
        "optional_fields": []
      },
      "APPLY": {
        "label": "Apply",
        "enabled": true,
        "required_fields": [
          "effectId"
        ],
        "optional_fields": [
          "power",
          "duration",
          "interval",
          "stackGain"
        ],
        "required_fields_by_registry_effect_kind": {
          "STATUS": [
            "duration"
          ],
          "DOT": [
            "power",
            "duration"
          ],
          "BUFF": [
            "power",
            "duration"
          ],
          "DEBUFF": [
            "power",
            "duration"
          ],
          "SHIELD": [
            "power",
            "duration"
          ]
        }
      },
      "REMOVE": {
        "label": "Remove",
        "enabled": true,
        "required_fields": [
          "category"
        ],
        "optional_fields": [
          "count",
          "all"
        ],
        "one_of_required": [
          [
            "count",
            "all"
          ]
        ],
        "supported_values": {
          "category": [
            "STATUS"
          ]
        }
      },
      "RESOURCE_CHANGE": {
        "label": "Resource",
        "enabled": true,
        "required_fields": [
          "resource",
          "amount"
        ],
        "optional_fields": [],
        "supported_values": {
          "resource": [
            "MP"
          ]
        }
      },
      "REVIVE": {
        "label": "Revive",
        "enabled": true,
        "required_fields": [],
        "optional_fields": [
          "hp",
          "hpRate"
        ],
        "one_of_required": [
          [
            "hp",
            "hpRate"
          ]
        ]
      },
      "TARGET_CONTROL": {
        "label": "Target Control",
        "enabled": true,
        "required_fields": [
          "mode",
          "trigger",
          "priority",
          "removable",
          "lifetime"
        ],
        "optional_fields": [
          "uses",
          "duration"
        ],
        "supported_values": {
          "mode": [
            "COVER"
          ],
          "trigger": [
            "DIRECT_ATTACK"
          ],
          "lifetime": [
            "PERSISTENT",
            "USES",
            "DURATION"
          ]
        },
        "conditional_required": [
          {
            "when": {
              "field": "lifetime",
              "equals": "USES"
            },
            "fields": [
              "uses"
            ]
          },
          {
            "when": {
              "field": "lifetime",
              "equals": "DURATION"
            },
            "fields": [
              "duration"
            ]
          }
        ]
      },
      "SPECIAL": {
        "label": "Special",
        "enabled": false,
        "required_fields": [],
        "optional_fields": [],
        "boundary": "DEFERRED",
        "reason": "SPECIAL requires an effect-specific contract and execution owner before Skill Runtime admission."
      }
    },
    "trigger": {
      "required_fields": [
        "type"
      ],
      "optional_fields": [
        "scope",
        "priority"
      ],
      "options_source": "triggers"
    },
    "condition": {
      "required_fields": [
        "scope",
        "property",
        "operator",
        "value"
      ],
      "options_source": "conditions",
      "operators": [
        "=",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ],
      "scope_default": "SELF",
      "value_type_controls": {
        "number": {
          "control": "number",
          "step": "any"
        },
        "rate": {
          "control": "number",
          "step": "any",
          "min": 0,
          "max": 1
        },
        "non_negative_integer": {
          "control": "number",
          "step": "1",
          "min": 0,
          "integer": true
        },
        "predicate": {
          "control": "select",
          "options": [
            true
          ],
          "operator_options": [
            "="
          ]
        }
      }
    },
    "target": {
      "required_fields": [
        "side",
        "range"
      ],
      "optional_fields": [
        "randomCount",
        "excludeSelf"
      ],
      "side_options_source": "targets.sides",
      "range_options_source": "targets.ranges"
    },
    "resource": {
      "optional_fields": [
        "mpCost",
        "cooldown",
        "activationPriority",
        "castTime"
      ]
    },
    "field_definitions": {
      "power": {
        "label": "効果量",
        "control": "number",
        "step": "any"
      },
      "damageType": {
        "label": "ダメージ種別",
        "control": "select",
        "options_source": "damage_types"
      },
      "elements": {
        "label": "属性配分",
        "control": "json",
        "placeholder": "[{\"element\":\"FIRE\",\"sharePercent\":30},{\"element\":\"ICE\"}]"
      },
      "effectId": {
        "label": "Effect",
        "control": "select",
        "options_source": "effects"
      },
      "duration": {
        "label": "持続時間",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "interval": {
        "label": "発生間隔",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "stackGain": {
        "label": "スタック増加",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "category": {
        "label": "解除カテゴリ",
        "control": "select"
      },
      "count": {
        "label": "解除件数",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "all": {
        "label": "全解除",
        "control": "boolean"
      },
      "resource": {
        "label": "リソース",
        "control": "select"
      },
      "amount": {
        "label": "変化量",
        "control": "number",
        "step": "any"
      },
      "hp": {
        "label": "蘇生HP",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "hpRate": {
        "label": "蘇生HP割合",
        "control": "number",
        "step": "any",
        "min": 1e-06,
        "max": 1
      },
      "mode": {
        "label": "対象制御モード",
        "control": "select"
      },
      "trigger": {
        "label": "対象制御Trigger",
        "control": "select"
      },
      "priority": {
        "label": "優先度",
        "control": "number",
        "step": "1"
      },
      "removable": {
        "label": "解除可能",
        "control": "boolean"
      },
      "lifetime": {
        "label": "寿命",
        "control": "select"
      },
      "uses": {
        "label": "使用回数",
        "control": "number",
        "step": "1",
        "min": 1
      },
      "castTime": {
        "label": "Cast Time (tick)",
        "control": "number",
        "step": "1",
        "min": 0,
        "integer": true
      }
    },
    "budget": {
      "rules_source": "../assets/shared/config/skill-budget-rules.json",
      "budgetRuleVersion": "G04-BUDGET-V1",
      "existing_skill_policy": "NO_AUTOMATIC_RECALCULATION"
    }
  },
  "triggers": {
    "ON_USE": {
      "enabled": true,
      "engine_event": "use",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_HIT_RECEIVED": {
      "enabled": true,
      "engine_event": "hit_received",
      "dispatch_mode": "COUNTER",
      "allowed_scopes": [
        "SELF"
      ],
      "runtime_contract": {
        "logic": "COUNTER",
        "requires_effect": "DAMAGE",
        "target_side": "ENEMY",
        "target_range": "SINGLE",
        "numeric_defaults": {
          "COUNTER_LIMIT": 1,
          "COUNTER_PRIORITY": 0
        }
      },
      "allowed_dispatch_modes": [
        "COUNTER",
        "ACTION"
      ]
    },
    "ON_DAMAGE_DEALT": {
      "enabled": true,
      "engine_event": "damage_dealt",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_TURN_START": {
      "enabled": true,
      "engine_event": "turn_start",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_TURN_END": {
      "enabled": true,
      "engine_event": "turn_end",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_DEATH": {
      "enabled": true,
      "engine_event": "death",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_STATUS_APPLIED": {
      "enabled": true,
      "engine_event": "status_applied",
      "dispatch_mode": "RESOLVE_ONLY",
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_ALLY_ATTACK": {
      "enabled": true,
      "engine_event": "ally_attack",
      "dispatch_mode": "FOLLOW_UP",
      "allowed_scopes": [
        "SELF"
      ],
      "runtime_contract": {
        "logic": "FOLLOW_UP",
        "requires_effect": "DAMAGE",
        "requires_condition": "TARGET_POISONED",
        "target_side": "ENEMY",
        "target_range": "SINGLE",
        "numeric_defaults": {}
      }
    },
    "WHILE_SOURCE_ALIVE": {
      "enabled": true,
      "engine_event": "aura_evaluate",
      "dispatch_mode": "AURA",
      "allowed_scopes": [
        "SELF"
      ],
      "runtime_contract": {
        "logic": "AURA",
        "requires_effect_type": "APPLY",
        "target_sides": [
          "ALLY",
          "ENEMY"
        ],
        "target_range": "ALL",
        "stack": "highest",
        "numeric_defaults": {}
      }
    },
    "ON_CRITICAL": {
      "enabled": true,
      "engine_event": "critical",
      "phase": "REACTIVE",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_HIT_DEALT": {
      "enabled": true,
      "engine_event": "hit_dealt",
      "phase": "REACTIVE",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_EVADE": {
      "enabled": true,
      "engine_event": "evade",
      "phase": "REACTIVE",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_BLOCK": {
      "enabled": true,
      "engine_event": "block",
      "phase": "REACTIVE",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_BATTLE_START": {
      "enabled": true,
      "engine_event": "battle_start",
      "phase": "REACTIVE",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    },
    "ON_FATAL_DAMAGE": {
      "enabled": true,
      "engine_event": "fatal_damage",
      "phase": "INTERRUPT",
      "dispatch_mode": "ACTION",
      "allowed_dispatch_modes": [
        "ACTION"
      ],
      "allowed_scopes": [
        "SELF"
      ]
    }
  },
