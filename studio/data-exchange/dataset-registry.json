{
  "format": "GKS_DATA_EXCHANGE_DATASET_REGISTRY",
  "version": "1.0.0-draft",
  "datasets": {
    "monsters": {
      "path": "masters.monsters",
      "id_field": "id",
      "volatile_fields": ["updated_at", "created_at", "generated_at"],
      "unordered_arrays": ["tags", "params.skill_ids", "params.candidate_skill_ids", "params.equipment_ids", "params.mod_ids"],
      "dependencies": ["tags", "skills", "jobs", "equipment", "mods", "ai_conditions", "ai_targets", "ai_actions"]
    },
    "tags": {"path": "tags", "id_field": "id", "volatile_fields": ["updated_at", "created_at", "generated_at"], "unordered_arrays": ["aliases"]},
    "skills": {"path": "masters.skills", "id_field": "id", "volatile_fields": ["updated_at", "created_at", "generated_at"], "unordered_arrays": ["tags", "params.required_tags"]}
  }
}
