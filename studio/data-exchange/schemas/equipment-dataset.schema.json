{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-dataset.schema.json",
  "title": "GKS Data Exchange Equipment Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {},
      "status": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "params": {
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "mod_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "item_level": {
        "type": "number",
        "minimum": 0
      },
      "mod_budget": {
        "type": "number",
        "minimum": 0
      },
      "mod_count": {
        "type": "number",
        "minimum": 0
      },
      "required_str": {
        "type": "number",
        "minimum": 0
      },
      "required_dex": {
        "type": "number",
        "minimum": 0
      },
      "required_int": {
        "type": "number",
        "minimum": 0
      },
      "required_vit": {
        "type": "number",
        "minimum": 0
      },
      "required_mnd": {
        "type": "number",
        "minimum": 0
      },
      "required_agi": {
        "type": "number",
        "minimum": 0
      },
      "attack": {
        "type": "number",
        "minimum": 0
      },
      "accuracy": {
        "type": "number",
        "minimum": 0
      },
      "magic_weapon_bonus": {
        "type": "number",
        "minimum": 0
      },
      "weapon_critical_rate": {
        "type": "number",
        "minimum": 0
      },
      "hp_bonus": {
        "type": "number",
        "minimum": 0
      },
      "mp_bonus": {
        "type": "number",
        "minimum": 0
      },
      "evasion": {
        "type": "number",
        "minimum": 0
      },
      "armor_category": {
        "type": "string"
      },
      "armor_slot": {
        "type": "string"
      },
      "generation": {
        "type": "object"
      },
      "block_rate": {
        "type": "number",
        "minimum": 0
      },
      "block_damage_cut_rate": {
        "type": "number",
        "minimum": 0
      }
    },
    "additionalProperties": true,
    "not": {
      "required": [
        "base_critical_rate"
      ]
    }
  },
  "properties": {}
}
