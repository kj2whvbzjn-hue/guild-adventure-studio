{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monster-dataset.schema.json",
  "title": "GKS Data Exchange Monster Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "formalAiBinding"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "params": {
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "default_formation_position": {
        "type": "string",
        "enum": [
          "FRONTLINE",
          "BACKLINE"
        ],
        "default": "FRONTLINE"
      },
      "formalAiBinding": {
        "type": "object",
        "required": [
          "program_id",
          "layout_id"
        ],
        "properties": {
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "layout_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": true
  }
}
