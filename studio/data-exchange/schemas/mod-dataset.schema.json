{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mod-dataset.schema.json",
  "title": "GKS Data Exchange MOD Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {},
      "status": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "params": {
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
