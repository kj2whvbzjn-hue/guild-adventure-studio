{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-dialogue-dataset.schema.json",
  "title": "GKS Data Exchange Story Dialogue Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "chapter_id",
      "section_id",
      "scene_id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "chapter_id": {
        "type": "string",
        "minLength": 1
      },
      "section_id": {
        "type": "string",
        "minLength": 1
      },
      "scene_id": {
        "type": "string",
        "minLength": 1
      },
      "no": {
        "type": "integer",
        "minimum": 1
      },
      "status": {
        "type": "string"
      },
      "speaker": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "stage_direction": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
