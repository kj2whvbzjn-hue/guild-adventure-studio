{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-dataset.schema.json",
  "title": "GKS Data Exchange Job Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {},
      "status": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "params": {
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "str": {
        "type": "integer",
        "minimum": 0
      },
      "vit": {
        "type": "integer",
        "minimum": 0
      },
      "agi": {
        "type": "integer",
        "minimum": 0
      },
      "dex": {
        "type": "integer",
        "minimum": 0
      },
      "int": {
        "type": "integer",
        "minimum": 0
      },
      "mnd": {
        "type": "integer",
        "minimum": 0
      },
      "luk": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": true
  }
}
