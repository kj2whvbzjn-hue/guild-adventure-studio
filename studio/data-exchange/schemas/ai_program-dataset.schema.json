{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_program-dataset.schema.json",
  "title": "GKS Data Exchange AI Program Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "status", "version", "schema_version", "entry_node_id", "nodes", "edges", "subroutines"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "status": {"type": "string", "enum": ["draft", "valid", "invalid", "archived"]},
      "tags": {"type": "array", "items": {"type": "string"}},
      "description": {"type": "string"},
      "version": {"type": ["integer", "string"]},
      "schema_version": {"type": "string"},
      "data_version": {"type": ["integer", "string", "null"]},
      "entry_node_id": {"type": "string"},
      "nodes": {"type": "array", "items": {"type": "object"}},
      "edges": {"type": "array", "items": {"type": "object"}},
      "subroutines": {"type": "array", "items": {"type": "object"}},
      "compiled": {"type": ["object", "null"]},
      "created_at": {"type": "string"},
      "updated_at": {"type": "string"}
    },
    "additionalProperties": true
  }
}
