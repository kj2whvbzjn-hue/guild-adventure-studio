{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter-dataset.schema.json",
  "title": "GKS Data Exchange Story Chapter Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "no": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string"
      },
      "theme": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "purpose": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "design": {
        "type": "object"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "candidate_revisions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "export_control": {
        "type": "object"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
