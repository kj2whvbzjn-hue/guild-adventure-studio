{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-section-dataset.schema.json",
  "title": "GKS Data Exchange Story Section Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "chapter_id",
      "title"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "chapter_id": {
        "type": "string",
        "minLength": 1
      },
      "no": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "purpose": {
        "type": "string"
      },
      "start_state": {
        "type": "string"
      },
      "end_state": {
        "type": "string"
      },
      "key_points": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "design": {
        "type": "object"
      },
      "candidate_revisions": {
        "type": "array"
      },
      "export_control": {
        "type": "object"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "adventure_duration_seconds": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "boxes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "type",
            "ref_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "scene",
                "event",
                "random_event",
                "random_battle"
              ]
            },
            "ref_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
