{
  "schema_version": 1,
  "component": "studio-ai-production",
  "entrypoints": {
    "ui": "ai-production-ui.js",
    "store": "ai-program-store.js",
    "editor": "ai-program-editor.js",
    "battle_adapter": "ai-battle-adapter.js",
    "simulation_runner": "ai-simulation-runner.js",
    "export_adapter": "ai-export-adapter.js"
  },
  "public_globals": [
    "GKSAIProductionUI",
    "GKSAIProgramModel",
    "GKSAILayoutModel",
    "GKSAIConnectionResolver",
    "GKSAIProgramStore",
    "GKSAIProgramEditor",
    "GKSAIProgramValidator",
    "GKSAIProgramCompiler",
    "GKSAIProgramTrace",
    "GKSAIDecisionEngine",
    "GKSAIBattleRuntimeContext",
    "GKSAIBattleAdapter",
    "GKSAISimulationRunner",
    "GKSAIExportAdapter",
    "GKSAIMasterAdapter"
  ],
  "data_ownership": [
    "data.ai_programs",
    "data.ai_program_layouts",
    "data.ai_program_runtime",
    "editor draft state (memory only)",
    "layout draft state (memory only)",
    "connection graph (derived only)"
  ],
  "reads": [
    "data.masters.ai_searches",
    "data.masters.ai_conditions",
    "data.masters.ai_target_selectors",
    "data.masters.ai_actions",
    "data.masters.skills",
    "data.tags"
  ],
  "integrations": {
    "data_exchange_datasets": [
      "ai_programs",
      "ai_program_layouts",
      "ai_program_runtime"
    ],
    "dependency_mode": "recursive",
    "import_boundary": "DataExchangeTransaction"
  },
  "must_not_write": [
    "data.masters",
    "data.tags",
    "battle.units",
    "localStorage"
  ],
  "shared_canonical": {
    "program_model": "shared/ai/ai-program-model.js",
    "layout_model": "shared/ai/ai-layout-model.js",
    "master_adapter": "shared/ai/ai-master-adapter.js",
    "connection_resolver": "shared/ai/ai-connection-resolver.js",
    "program_validator": "shared/ai/ai-program-validator.js",
    "program_compiler": "shared/ai/ai-program-compiler.js",
    "program_trace": "shared/ai/ai-program-trace.js",
    "decision_engine": "shared/ai/ai-decision-engine.js",
    "battle_runtime_context": "shared/ai/ai-battle-runtime-context.js"
  },
  "authoring_authority": {
    "program_type": "開発者作成AIプログラム",
    "author": "Developer",
    "location": "Studio > 制作 > AI制作",
    "canonical_storage": "Studio Project Data",
    "player_facing": false,
    "game_graph_authoring": false
  }
}
