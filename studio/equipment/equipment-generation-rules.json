{
  "schema": "GKS_EQUIPMENT_GENERATION_RULES",
  "generation_rules_version": "1.3.0",
  "source_spec_version": "Equipment完全統合仕様_v1.1 + 防具係数仕様",
  "balance_value_policy": "All tunable numeric values are loaded from Active Balance Config; Generation Rules define structure only.",
  "flow": [
    "ai_or_manual_input",
    "active_config",
    "base_item_calculation",
    "validator",
    "preview",
    "commit"
  ],
  "weapon": {
    "required_fields": [
      "required_str",
      "required_dex",
      "required_int"
    ],
    "performance_fields": [
      "attack",
      "accuracy",
      "magic_weapon_bonus",
      "base_critical_rate"
    ]
  },
  "armor": {
    "required_inputs": [
      "base_item_type",
      "armor_slot",
      "item_level"
    ],
    "required_fields": [
      "required_vit",
      "required_mnd",
      "required_agi"
    ],
    "performance_fields": [
      "hp_bonus",
      "mp_bonus",
      "evasion"
    ]
  },
  "forbidden_fields": [
    "base_attack",
    "base_defense",
    "defense"
  ],
  "requirements_are_equip_gate_only": true,
  "pipeline_modes": [
    "single",
    "batch_simulation",
    "batch_generation",
    "ai_request"
  ],
  "batch_simulation_writes_master": false,
  "ai_numeric_authority": "forbidden"
}
